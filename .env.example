# ==============================================================================
# DentalCare Luxury Clinic — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this template to `.env`:
#      cp .env.example .env
# 2. Update the secret values for production deployment.
# 3. Keep .env secure and NEVER commit production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
# Active Spring Boot profile (default, prod, dev)
SPRING_PROFILES_ACTIVE=prod

# Server listening port inside container (default: 8080)
PORT=8080
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Storage & Directory Paths
# ------------------------------------------------------------------------------
# Host path / named volume mount directory for persistent database files
DATA_DIR=./data

# Host path / named volume mount directory for uploaded patient dental images
UPLOAD_DIR=./uploads
APP_UPLOAD_DIR=/app/uploads/dental-images/

# ------------------------------------------------------------------------------
# 3. Database Persistence Configuration
# ------------------------------------------------------------------------------
# Default: Embedded H2 database with AUTO_SERVER mode enabled
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/dentaldb;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password

# Production PostgreSQL Alternative (uncomment to switch):
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dentalcare
# SPRING_DATASOURCE_USERNAME=dentalcare_admin
# SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password

# ------------------------------------------------------------------------------
# 4. Security & Cryptography Secrets
# ------------------------------------------------------------------------------
# JSON Web Token (JWT) HMAC-SHA256 Signing Secret (Minimum 256-bit / 32-bytes random string)
APP_JWT_SECRET=dentalcareluxurysecuresecretkey2026superstrongforproductiontokengeneration32bytes

# JWT Expiration duration in milliseconds (default: 86400000 = 24 hours)
APP_JWT_EXPIRATION_MS=86400000

# Electronic Medical Record (EMR) AES-256-GCM symmetric encryption key (32 bytes)
APP_SECURITY_AES_KEY=DentalCare2026LuxuryClinicSecureKeyForMedicalEMRAES256GCM

# ------------------------------------------------------------------------------
# 5. Cloudflare Zero Trust Ingress & Custom Domain
# ------------------------------------------------------------------------------
# Cloudflare Tunnel Authentication Token.
# - If blank: deploy-all.sh / vps-sync.sh automatically launches ephemeral TryCloudflare
#   tunnel (https://<random>.trycloudflare.com).
# - If provided: Connects directly to your Cloudflare Zero Trust Named Tunnel for your
#   official custom domain.
CLOUDFLARE_TUNNEL_TOKEN=

# Production Custom Domain mapped to Cloudflare Named Tunnel
CLOUDFLARE_CUSTOM_DOMAIN=nhakhoadentalcare.id.vn

# Cloudflare Tunnel Native Command:
# - Leave blank for automatic selection by deployment scripts:
#   * If token is provided: tunnel --no-autoupdate --metrics 0.0.0.0:2000 run
#   * If token is empty: tunnel --no-autoupdate --metrics 0.0.0.0:2000 --url http://app:8080
# - Or explicitly override here:
# CLOUDFLARE_TUNNEL_COMMAND=tunnel --no-autoupdate --metrics 0.0.0.0:2000 --url http://app:8080
CLOUDFLARE_TUNNEL_COMMAND=

# ------------------------------------------------------------------------------
# 6. Container Runtime & JVM Optimization
# ------------------------------------------------------------------------------
# Cgroup-aware container JVM flags:
# - MaxRAMPercentage=75.0: Allocates 75% of container RAM to JVM heap
# - ExitOnOutOfMemoryError: Fail fast on heap exhaustion for auto-restart
# - java.security.egd: Non-blocking entropy source for fast cryptographic init
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# ------------------------------------------------------------------------------
# 7. Mail & Notification Service (SMTP)
# ------------------------------------------------------------------------------
SPRING_MAIL_USERNAME=demo@dentalcare.vn
SPRING_MAIL_PASSWORD=demopassword
